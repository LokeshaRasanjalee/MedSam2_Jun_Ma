    "version": "0.2.0",
    "configurations": [ 

        

        {
            "name": "MedSAM2 Video Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "medsam2_infer_video.py",
            "console": "integratedTerminal",
            "args": "--base_video_dir ./media/image/ --input_mask_dir ./media/mask/ -o ./media/Inference --use_all_masks"
        },
        {
            "name": "L2D Train",
            "type": "debugpy",
            "request": "launch",
            "program": "L2D_train.py",
            "console": "integratedTerminal",
            "args": "--base_video_dir ./media/image/ --input_mask_dir ./media/mask/ -o ./media/Inference"
        }
    ]
}